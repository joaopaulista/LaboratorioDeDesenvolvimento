+        ordem.verify(pedidoRepository, times(1)).salvar(pedidoEsperado);
+        ordem.verify(notificador, times(1)).enviarConfirmacao(EMAIL, "PED-42", total);
+        verify(estoqueGateway, never()).liberar(anyString(), anyInt());
